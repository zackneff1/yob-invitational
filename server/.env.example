# ── Server ────────────────────────────────────────────────────────────────
# Port the server listens on. Render injects PORT automatically — never set it there.
PORT=3001

# development | production | test
NODE_ENV=development

# Secret used to sign auth tokens (JWTs).
# REQUIRED in production. The Render blueprint auto-generates one.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Shared code the group uses to claim their player profile on first sign-in.
# Keeps randos from claiming a spot if the URL leaks.
INVITE_CODE=yob2026

# ── Database ──────────────────────────────────────────────────────────────
# Postgres connection string. On Render this is wired from the yob-db
# database in render.yaml. For local dev, either point at a Postgres you
# already run, or `docker compose up -d` and use the default below.
DATABASE_URL=postgresql://yob:yob@localhost:5432/yob_invitational

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info
