generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id            String  @id
  name          String
  email         String? @unique
  passwordHash  String?
  isAdmin       Boolean @default(false)
  handicapIndex Float

  scores Score[]
}

model Course {
  id       String  @id
  name     String
  location String
  tee      String
  par      Int
  rating   Float
  slope    Int
  /// [{ number, par, strokeIndex }]
  holes    Json
  notes    String?

  rounds Round[]
}

model Round {
  id          String   @id
  name        String
  courseId    String
  date        String
  dayLabel    String
  teeTimes    String[]
  format      String
  formatLabel String
  allowance   Float
  playOffLow  Boolean
  matchCount  Int
  description String
  /// 'upcoming' | 'live' | 'final' — admins start and end rounds from the Admin tab.
  status      String    @default("upcoming")
  startedAt   DateTime?
  endedAt     DateTime?
  /// Frozen scoring basis (course card, indexes, allowance, policy version,
  /// lineups) captured when the round is started. Null = scored live.
  scoringSnapshot Json?

  course   Course    @relation(fields: [courseId], references: [id])
  pairings Pairing[]
  matches  Match[]
  scores   Score[]
}

model Pairing {
  id        String   @id @default(uuid())
  roundId   String
  name      String
  playerIds String[]
  teeTime   String?

  round Round @relation(fields: [roundId], references: [id])

  @@index([roundId])
}

model RyderTeam {
  id        String   @id // 'A' | 'B'
  name      String
  color     String
  captainId String?
  playerIds String[]
}

model Match {
  id      String   @id @default(uuid())
  roundId String
  teeTime String?
  sideA   String[]
  sideB   String[]
  result  String? // 'A' | 'B' | 'HALVED' — admin override
  /// Stamped when the match becomes final, and again whenever a final result
  /// changes; drives the "match closed" alerts together with resultKey.
  closedAt DateTime?
  /// Identity of the final result the stamp refers to, e.g. "A:3&2", "HALVED".
  resultKey String?

  round Round @relation(fields: [roundId], references: [id])

  @@index([roundId])
}

model Score {
  roundId    String
  entityType String // 'player' | 'side'
  entityId   String // playerId, or `${matchId}:A` / `${matchId}:B` for scramble sides
  hole       Int
  /// Gross strokes. Null only when pickup is true (no return on the hole).
  strokes    Int?
  /// Explicit pickup / no-return: the ball does not count on this hole.
  pickup     Boolean  @default(false)
  updatedAt  DateTime
  updatedBy  String

  round  Round  @relation(fields: [roundId], references: [id])
  editor Player @relation(fields: [updatedBy], references: [id])

  @@id([roundId, entityType, entityId, hole])
}

/// Small key/value store for trip info that must not live in the (public) source
/// repo and needs no table of its own — lodging door codes, for example.
model Setting {
  key   String @id
  value String
}
